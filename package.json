{
  "name": "black-week-pris",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @bwp/api dev",
    "dev:mobile": "pnpm --filter @bwp/mobile start",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter @bwp/db migrate",
    "db:seed": "pnpm --filter @bwp/db seed",
    "db:reset": "pnpm --filter @bwp/db reset"
  },
  "devDependencies": {
    "turbo": "^2.11.13",
    "typescript": "~6.0.3"
  }
}
